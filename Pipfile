[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = "<5"
django-cms = "<4"
fabric = "*"
djangocms-text-ckeditor = "*"
djangocms-file = "*"
djangocms-picture = "*"
djangocms-link = "*"
django-recaptcha = "*"
djangocms-style = "*"
djangocms-snippet = "*"
djangocms-video = "*"
# Pulled in by djangocms-video, which asks only for django-filer>=1.7.
# From 3.5 filer depends on py-svg-hush, a Rust extension with no macOS
# wheel below CPython 3.11, so an unpinned resolve breaks "pipenv lock"
# on a mac.  Lift this once the project moves to python 3.11 or newer.
django-filer = "<3.5"
djangorestframework = "*"
django-taggit = "~=3.0"
# djangocms-page-tags = "*" -- doesn't work with newer versons of django cms
mysql-connector-python = "*"
# mysqlclient deliberately absent.  It is a compiled extension linked
# against libmysqlclient, which is what DreamHost's move to Ubuntu 26.04
# broke and what took production down; it also needs a compiler the
# servers do not have.  Nothing imports it: every environment uses
# mysql.connector.django instead.
paypal-checkout-serversdk = "*"
# Was an unpinned git dependency, so every lock silently took whatever
# django-wiki's main branch was that day.  0.13 is released on PyPI
# and is the same code, minus unreleased commits.
wiki = "~=0.13.0"
django-hijack = "*"
django-autocomplete-light = "*"
gunicorn = "*"
# django-polymorphic imports typing_extensions unconditionally, but the
# resolver marks it as only needed below python 3.11, so it is skipped on
# anything newer and django will not start.  Listed here so it installs
# whatever python the environment is on.
typing-extensions = "*"

[dev-packages]
autopep8 = "*"
black = "*"

[requires]
python_version = "3.10"
